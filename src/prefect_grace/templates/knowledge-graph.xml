  <rules>
    <rule id="RULE-001">
      <name>Architect Creates READY</name>
      <description>POST /api/architect/plan creates packets in READY state (not DRAFT). Worker can claim immediately.</description>
      <source>CANONICAL_DECISIONS.md §5</source>
    </rule>

    <rule id="RULE-002">
      <name>Claim Owns READY→RUNNING</name>
      <description>POST /api/packets/claim is the SOLE owner of the READY → RUNNING transition. Adapter does NOT change packet state.</description>
      <source>CANONICAL_DECISIONS.md §5</source>
    </rule>

    <rule id="RULE-003">
      <name>Adapter is Stateless</name>
      <description>PacketExecutionAdapter does NOT call mark_running, mark_accepted, or any state transition. It only materializes packet, calls legacy runner, and returns ExecutionResult.</description>
      <source>CANONICAL_DECISIONS.md §5</source>
    </rule>

    <rule id="RULE-004">
      <name>Worker Releases via API</name>
      <description>After adapter returns, worker calls POST /api/packets/{id}/release. Release endpoint transitions RUNNING → ACCEPTED/REJECTED/FAILED.</description>
      <source>CANONICAL_DECISIONS.md §5</source>
    </rule>

    <rule id="RULE-005">
      <name>Max 3 Attempts</name>
      <description>Packets may be retried up to 3 times (max_attempts=3). After 3 failures, manual intervention required.</description>
      <source>FINAL_DECISIONS.md §5</source>
    </rule>

    <rule id="RULE-006">
      <name>No Parallel Conflicting Packets</name>
      <description>Two packets that touch the same file (overlapping write scopes) must not execute in parallel.</description>
      <source>FINAL_DECISIONS.md §3</source>
    </rule>

    <rule id="RULE-007">
      <name>MVP-0 Ends at ACCEPTED</name>
      <description>MVP-0 does not auto-merge. ACCEPTED → MERGED is post-MVP (Wave 1).</description>
      <source>CANONICAL_DECISIONS.md §9</source>
    </rule>

    <rule id="RULE-008">
      <name>Single Worker in MVP-0</name>
      <description>Only one worker process in MVP-0. Multiple workers = post-MVP (Wave 4).</description>
      <source>CANONICAL_DECISIONS.md §6</source>
    </rule>
  </rules>
