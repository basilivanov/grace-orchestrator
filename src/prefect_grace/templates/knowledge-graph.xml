  <concepts>
    <!-- ====== Core Domain Entities ====== -->
    <concept id="CONCEPT-FEATURE">
      <name>Feature</name>
      <description>Top-level business feature. Has waves, packets. Status: NOT_STARTED, IN_PROGRESS, COMPLETED.</description>
      <category>domain</category>
      <table>features</table>
      <attributes>
        <attribute name="id">FEAT-USER-AUTH (hierarchical prefix)</attribute>
        <attribute name="slug">user-auth</attribute>
        <attribute name="title">Human-readable title</attribute>
        <attribute name="spec_json">Full feature specification</attribute>
        <attribute name="status">NOT_STARTED | IN_PROGRESS | COMPLETED</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-WAVE">
      <name>Wave</name>
      <description>Logical group of packets executed sequentially. Each wave ends with architect gate_decision packet.</description>
      <category>domain</category>
      <table>waves</table>
      <attributes>
        <attribute name="id">W01-FOUNDATION</attribute>
        <attribute name="feature_id">Parent feature</attribute>
        <attribute name="order">Sequential order (1, 2, 3...)</attribute>
        <attribute name="status">NOT_STARTED | IN_PROGRESS | COMPLETED</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-PACKET">
      <name>Packet</name>
      <description>Self-contained work unit: specification of WHAT to do. Has hierarchical ID, scope, acceptance profile, state.</description>
      <category>domain</category>
      <table>packets</table>
      <attributes>
        <attribute name="id">FEAT-X-W01-P01-ACTION</attribute>
        <attribute name="state">DRAFT | READY | RUNNING | ACCEPTED | MERGED | REJECTED | FAILED | CANCELLED</attribute>
        <attribute name="acceptance_profile">FAST | NORMAL | STRICT</attribute>
        <attribute name="attempt_count">Current attempt (0..max_attempts)</attribute>
        <attribute name="max_attempts">Max retry attempts (default 3)</attribute>
        <attribute name="spec_json">Scope, requirements, dependencies</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-RUN">
      <name>PacketRun</name>
      <description>One execution attempt of a packet. Packet may have multiple runs (R01, R02, R03).</description>
      <category>domain</category>
      <table>packet_runs</table>
      <attributes>
        <attribute name="id">FEAT-X-W01-P01-ACTION-R01</attribute>
        <attribute name="packet_id">Parent packet</attribute>
        <attribute name="run_number">1, 2, 3...</attribute>
        <attribute name="status">running | accepted | rejected | failed</attribute>
        <attribute name="result_json">Full execution result</attribute>
        <attribute name="evidence_path">Path to evidence directory</attribute>
        <attribute name="duration_ms">Execution duration</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-WORKER">
      <name>Worker</name>
      <description>Execution agent: registers with API, claims packets, executes via adapter, releases result.</description>
      <category>infrastructure</category>
      <table>workers</table>
      <attributes>
        <attribute name="id">worker-abc123</attribute>
        <attribute name="status">active | idle | dead</attribute>
        <attribute name="current_packet_id">Currently executing packet</attribute>
        <attribute name="last_heartbeat">Last heartbeat timestamp</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-LEASE">
      <name>Lease</name>
      <description>Exclusive claim on a packet by a worker. SQLite-safe (unique constraint on packet_id).</description>
      <category>infrastructure</category>
      <table>leases</table>
      <attributes>
        <attribute name="packet_id">Claimed packet (unique)</attribute>
        <attribute name="worker_id">Claiming worker</attribute>
        <attribute name="expires_at">Lease expiration (30 min from claim)</attribute>
        <attribute name="heartbeat_at">Last heartbeat refresh</attribute>
      </attributes>
    </concept>

    <concept id="CONCEPT-EVENT">
      <name>Event</name>
      <description>Audit log entry for state transitions and system events. Traceable via trace_id.</description>
      <category>infrastructure</category>
      <table>events</table>
      <attributes>
        <attribute name="event_type">state_transition | worker_heartbeat | packet_claimed | packet_released | error</attribute>
        <attribute name="entity_type">packet | worker | feature | wave</attribute>
        <attribute name="entity_id">ID of affected entity</attribute>
        <attribute name="trace_id">Correlation ID for tracing</attribute>
      </attributes>
    </concept>

    <!-- ====== Agent Roles ====== -->
    <concept id="CONCEPT-ARCHITECT">
      <name>Architect Agent</name>
      <description>Creates features, waves, and packets from business specs. Packets created in READY state.</description>
      <category>agent</category>
      <model>claude-opus-4</model>
      <reasoning>xhigh</reasoning>
    </concept>

    <concept id="CONCEPT-CODER">
      <name>Coder Agent</name>
      <description>Implements one packet within allowed write scope. Works in isolated git worktree.</description>
      <category>agent</category>
      <model>claude-sonnet-4</model>
      <reasoning>high</reasoning>
    </concept>

    <concept id="CONCEPT-VERIFIER">
      <name>Verifier Agent</name>
      <description>Runs T0 (lint+canon) → T1 (touched tests) → T2 (full tests). Checks scope compliance. Collects evidence.</description>
      <category>agent</category>
      <model>gemini-3.1-pro</model>
      <reasoning>medium</reasoning>
    </concept>

    <concept id="CONCEPT-REVIEWER">
      <name>Reviewer Agent</name>
      <description>Technical acceptance gate for STRICT packets. Verdicts: accepted, rework_required, blocked, escalate_to_architect.</description>
      <category>agent</category>
      <model>claude-opus-4</model>
      <reasoning>xhigh</reasoning>
    </concept>

    <!-- ====== Execution Infrastructure ====== -->
    <concept id="CONCEPT-ADAPTER">
      <name>PacketExecutionAdapter</name>
      <description>Bridge: DB packet → materialize markdown → call legacy run_e2e_packet → parse E2EPacketRunnerResult → return ExecutionResult. STATELESS: does NOT change packet state.</description>
      <category>infrastructure</category>
      <location>grace_control/adapters/packet_executor.py</location>
    </concept>

    <concept id="CONCEPT-SCOPE-GUARD">
      <name>Scope Guard</name>
      <description>Deterministic (non-LLM) validation: agent changes must respect Allowed Write Scope and Frozen Scope. Pattern-based file matching.</description>
      <category>infrastructure</category>
      <location>prefect_grace/platform/scope_guard.py</location>
    </concept>

    <concept id="CONCEPT-STATE-MACHINE">
      <name>Packet State Machine</name>
      <description>Validates transitions between 8 canonical states. CANCELLED reserved for post-MVP.</description>
      <category>core</category>
      <location>grace_control/core/state_machine.py</location>
    </concept>
  </concepts>

