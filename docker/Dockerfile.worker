FROM python:3.12-slim

ARG GRACE_UID=1001
ARG GRACE_GID=1003

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/grace \
    GRACE_HOME=/var/lib/grace-orchestrator

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        openssh-client \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${GRACE_GID}" grace \
    && useradd --uid "${GRACE_UID}" --gid "${GRACE_GID}" --home-dir /home/grace --create-home --shell /bin/bash grace

WORKDIR /workspace

COPY requirements.txt /tmp/grace-requirements.txt
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install -r /tmp/grace-requirements.txt

RUN mkdir -p /var/lib/grace-orchestrator \
    && chown -R grace:grace /home/grace /var/lib/grace-orchestrator

USER grace

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["prefect", "worker", "start", "--pool", "${GRACE_WORK_POOL:-default}", "--work-queue", "${GRACE_LIVE_QUEUE:-grace-live}"]
